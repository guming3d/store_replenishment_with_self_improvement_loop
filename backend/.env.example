# Microsoft Foundry project settings for the agent-orchestrated replenishment path.
# Copy this file to `.env` (same folder) and fill in your values, then run `az login`.
# The deterministic algorithm engine works without these; the "Agent 编排" toggle
# activates only when these are set and `agent-framework` is installed.

# Foundry project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=

# Chat model deployment name in that project, e.g. gpt-4o
FOUNDRY_MODEL_DEPLOYMENT=

# Optional tuning for the agent batch run
# AGENT_BATCH_CONCURRENCY=4
# AGENT_MAX_SKUS=0

# Attribution persistence: SQLite locally; PostgreSQL (asyncpg) in deployment.
# ATTRIBUTION_DATABASE_URL=sqlite+aiosqlite:///./attribution.db
# ATTRIBUTION_DATABASE_URL=postgresql+asyncpg://<entra-db-user>@<server>:5432/<database>
# ATTRIBUTION_POSTGRES_ENTRA_AUTH=true
# ATTRIBUTION_POSTGRES_MANAGED_IDENTITY_CLIENT_ID=<database-user-assigned-identity-client-id>
# FOUNDRY_MANAGED_IDENTITY_CLIENT_ID=<optional-foundry-user-assigned-identity-client-id>
# ATTRIBUTION_RUN_MIGRATIONS_ON_STARTUP=false
# AZURE_USE_MANAGED_IDENTITY=true
# ATTRIBUTION_WORKER_ENABLED=true
# ATTRIBUTION_WORKER_CONCURRENCY=4

# Development only. Persist each attribution model/tool input and output in the
# authenticated Agent Trace JSONL log. Credentials and private reasoning remain redacted.
ATTRIBUTION_DEBUG_RAW_IO=false
